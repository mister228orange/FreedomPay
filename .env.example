# Shared secret for merchant API
API_KEY=change-me-freedompay

# Public base URL of this service (used in exit / embed links)
PUBLIC_BASE_URL=http://localhost:8090

# Optional webhook when invoice is paid
MERCHANT_WEBHOOK_URL=http://backend:8000/api/v1/payments/webhook/freedompay
MERCHANT_WEBHOOK_SECRET=change-me-webhook

NETWORK=testnet
DEMO_MODE=true
SERVICE_FEE_PERCENT=1.5

# Invoice amounts default to USD; ceil up to this step (10 cents)
DEFAULT_FIAT=USD
USD_PRECISION=0.10
# Short memo / comment length for TON & SOL
MEMO_LENGTH=4

# Ignore junk transfers / reject invoices below this USD (~USDT)
DUST_IGNORE_USD=0.10

# Rough USD marks for the dust gate (override as needed)
PRICE_USD_BTC=95000
PRICE_USD_TON=5
PRICE_USD_SOL=150

# Default payment await window (seconds); per-chain overrides below
INVOICE_TTL_SECONDS=1800
INVOICE_TTL_BTC=3600
INVOICE_TTL_TON=1800
INVOICE_TTL_SOL=900
INVOICE_TTL_ETH=3600
INVOICE_TTL_POL=1800
INVOICE_TTL_TRX=1800
INVOICE_TTL_XMR=7200
# Default poll cadence; per-chain overrides
POLL_INTERVAL_SECONDS=20
POLL_INTERVAL_BTC=30
POLL_INTERVAL_TON=15
POLL_INTERVAL_SOL=10
POLL_INTERVAL_ETH=20
POLL_INTERVAL_POL=15
POLL_INTERVAL_TRX=20
POLL_INTERVAL_XMR=60
# Run Taskiq scheduler inside the API process
TASKIQ_EMBEDDED=true
DATABASE_URL=sqlite:////app/data/freedompay.db

# Watch-only receive wallets (leave empty to disable that chain)
WALLET_BTC=
WALLET_TON=
WALLET_SOL=
WALLET_XMR=
WALLET_TRX=
WALLET_ETH=
WALLET_POLYGON=

# Optional RPC overrides (empty → network defaults)
RPC_BTC=
RPC_SOLANA=
RPC_TON=
TON_API_KEY=
